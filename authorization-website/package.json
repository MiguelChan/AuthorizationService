{
  "name": "authorization-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "5.18.0",
    "@mui/lab": "5.0.0-alpha.177",
    "@mui/material": "5.18.0",
    "@reduxjs/toolkit": "2.13.0",
    "axios": "1.20.0",
    "formik": "2.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.4",
    "yup": "1.7.1"
  },
  "scripts": {
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src .storybook browser-tests vite.config.ts playwright.config.ts --max-warnings=0",
    "build": "npm run typecheck && npm run lint && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev --host localhost --port 6006 --ci",
    "build-storybook": "storybook build",
    "audit": "npm audit --audit-level=low",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "storybook": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.21.0 <12"
  }
}
